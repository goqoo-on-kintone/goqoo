{
  "name": "@goqoo/vite-plugin",
  "version": "2.0.0",
  "description": "Vite plugin for kintone customization (goqoo v2)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "*",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "vite-plugin-css-injected-by-js": "^5.0.1"
  }
}
